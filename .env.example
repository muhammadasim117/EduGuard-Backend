# Copy to .env and fill in. Never commit .env.

# AMD model on Token Factory (the default and only required path)
AMD_API_KEY=rc-783158cb375578283074f5dc9f75e8aff5b061bf6ac5b26b
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_MODEL=DeepSeek-V4.1-Flash
AMD_TIMEOUT=150
MAX_LOGS=15

# amd = AMD direct only (default) | auto = try Evolus then AMD | evolus = Evolus only
ANALYSIS_PROVIDER=amd

# Only needed if ANALYSIS_PROVIDER is auto or evolus
EVOLUS_APP_ID=
EVOLUS_API_KEY=
EVOLUS_AGENT_ID=
EVOLUS_TIMEOUT=90
