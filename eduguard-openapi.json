          }
        }
      }
    },
    "/reload": {
      "post": {
        "tags": [
          "meta"
        ],
        "summary": "Reload Data",
        "description": "Re-read the JSON files (after the data partner edits them). A bad file keeps the old data.",
        "operationId": "reload_data_reload_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReloadResponse"
                }
              }
            }
          },
          "422": {
            "description": "Data files could not be loaded; the current in-memory data is retained.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIError"
                }
              }
            }
          }
        }
      }
